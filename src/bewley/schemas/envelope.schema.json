{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/expectedparrot/bewley/main/src/bewley/schemas/envelope.schema.json",
  "title": "Bewley CLI envelope",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "status", "command", "argv", "data", "warnings", "errors", "next_steps"],
      "properties": {
        "schema_version": {"const": "2.0"},
        "status": {"enum": ["ok", "warning"]},
        "command": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "data": {},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "maxItems": 0},
        "next_steps": {"type": "array", "items": {"$ref": "action.schema.json"}}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "status", "command", "argv", "data", "warnings", "errors", "next_steps"],
      "properties": {
        "schema_version": {"const": "2.0"},
        "status": {"const": "error"},
        "command": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "data": {"type": "object", "maxProperties": 0},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "message", "context"],
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"},
              "context": {"type": "object"},
              "hint": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "next_steps": {"type": "array", "items": {"$ref": "action.schema.json"}}
      },
      "additionalProperties": false
    }
  ]
}
